# Copy to .env and adjust. Never commit a real .env.

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (mobile apps do not need CORS)
CORS_ORIGINS=

# Model files (exported by machine_learning/export/export_model.py)
MODEL_PATH=../machine_learning/weights/banknote_classifier.onnx
MODEL_LABELS_PATH=../machine_learning/weights/labels.json
MODEL_INPUT_SIZE=224

# DEMO MODE — returns a scripted sequence of results that are clearly
# flagged "demo": true. NEVER enable in production. Used only to exercise the UI
# before a real trained model exists.
DEMO_MODE=false

# Recognition thresholds (provisional, configurable)
MIN_CONFIDENCE=0.85
TORN_GOOD_MAX=5.0
TORN_DAMAGED_MAX=20.0
COUNT_DAMAGED_NOTES=true

# Image quality thresholds
MIN_BLUR_VARIANCE=60.0
MIN_BRIGHTNESS=45.0
MAX_BRIGHTNESS=225.0

# Upload limits
MAX_UPLOAD_BYTES=6000000
MAX_IMAGE_SIDE=4096

# Request processing timeout (seconds)
REQUEST_TIMEOUT_S=20

# Rate limiting (only applied when APP_ENV=production)
RATE_LIMIT=60/minute

# SQLite file for sessions
DATABASE_PATH=./data/banknote_assistant.db

# Analysis records (used to prevent client-forged scans) expire after N seconds
ANALYSIS_TTL_S=900
